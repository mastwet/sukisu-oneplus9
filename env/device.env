#!/bin/sh
# 设备与构建参数（所有脚本从本文件取值）
# 修改前请先读 README 的"硬性约束"

# ---- 设备 ----
DEVICE=lemonade
BOARD=sm8350
SOC=SM8350
ACTIVE_SLOT=_b
BOOT_PART=boot_b
BOOT_SIZE=201326592          # boot 分区字节数（实测 blockdev）

# ---- 系统 / 内核 ----
ROM_BUILD=23.2-20260525-NIGHTLY-lemonade
ROM_OTA_ZIP=lineage-23.2-20260525-NIGHTLY-lemonade.zip
ROM_OTA_PAGE=https://download.lineageos.org/lemonade

KERNEL_REPO=https://github.com/LineageOS/android_kernel_oneplus_sm8350
KERNEL_BRANCH=lineage-23.2
KERNEL_COMMIT=21b3312486b8      # 必须锁定：对应 release 串 5.4.302-qgki-g21b3312486b8
KERNEL_RELEASE=5.4.302-qgki-g21b3312486b8
DEFCONFIG=vendor/lahaina-qgki_defconfig
IMAGE_NAME=Image                # 设备树 BOARD_KERNEL_IMAGE_NAME := Image

# ---- SukiSU ----
SUKISU_REPO=https://github.com/SukiSU-Nova/SukiSU-Nova
SUKISU_SETUP_URL=https://git.zako.shirkneko.top:20004/shirkneko/SukiSU/raw/branch/main/kernel/setup.sh
SUKISU_TAG=v3.0.0               # 与管理器 Nova v3.0.0 配套
SUKISU_MANAGER_APK=SukiSU_Nova_v3.0.0_35000-arm64-v8a-release.apk
SUKISU_MANAGER_URL=https://github.com/SukiSU-Nova/SukiSU-Nova/releases/download/v3.0.0/SukiSU_Nova_v3.0.0_35000-arm64-v8a-release.apk
SUKISU_MANAGER_SHA256=1202adb835a64d8b3df703da7884a2966f8728c131cffb29fb5f48d31d81ac85
SUKISU_MANAGER_PKG=com.sukisu.ultra

# ---- 工具链 ----
# 首选：LLVM 21.1.0 官方预编译（已验证可下载）；也可用 AOSP prebuilt clang r563880
LLVM_VERSION=21.1.0
LLVM_TARBALL_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.0/LLVM-21.1.0-Linux-X64.tar.xz
CLANG_VER=r563880

# ---- 本机路径约定 ----
WORK=${WORK:-$(cd "$(dirname "$0")/.." && pwd)/work}
JOBS=${JOBS:-$(nproc)}
